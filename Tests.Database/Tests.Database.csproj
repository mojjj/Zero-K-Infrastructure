<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Database-backed tests for the Whole History Rating pipeline.

    Separate from Tests.Portable on purpose: that suite links pure sources, runs on .NET 9
    in about 150ms and needs nothing installed. This one needs a SQL Server container and
    the committed fixture, so it must never be what a developer runs by reflex.

    It targets net48 because the pipeline it tests - WholeHistoryRating, SpringBattle,
    ZkDataContext - is Entity Framework 6, which does not run on .NET 9. That is the
    blocker described in ZkData/EFCORE-MIGRATION.md; when it lifts, this project can move.

    OutputType is Exe so it can be run under mono, which has no working vstest runner.
    Program.cs discovers and runs the same [TestMethod]s that Visual Studio and the
    Windows CI runner would.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <GenerateProgramFile>false</GenerateProgramFile>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestFramework" Version="2.2.7" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.2.7" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZkData\ZkData.csproj" />
  </ItemGroup>

</Project>
