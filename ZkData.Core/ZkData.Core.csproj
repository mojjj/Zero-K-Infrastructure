<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The .NET 9 port of the data layer, built alongside the running one rather than in
    place of it.

    It LINKS the entity classes out of ZkData instead of copying them. That is the whole
    strategy: the same source files feed the EF6 model that production runs and the EF Core
    model being built, so the two cannot drift while the port is in progress, and the
    schema diff against db/schema/schema.txt measures a real difference rather than a
    transcription error.

    Progress is measured, not asserted:
        ./db/efcore-schema.sh            builds a database from this model and diffs it
                                         against the schema the EF6 migrations produce

    Nothing references this project yet. It is not in Zero-K.sln.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Pinned, not "latest". "latest" means whichever C# the machine's newest SDK happens to
      support, and that is not a property this port can leave to chance: the CI runner has
      SDK 10.0.12 installed alongside the 9.0.318 the workflow asks for, picks the higher one
      because nothing says otherwise, and compiles as C# 14. Under C# 14 an array converts to
      Span, which changes which extension method `array.Reverse()` binds to - it built here
      and failed there, on identical source. The claim this project exists to make is
      "compiles on .NET 9", so it compiles as C# 13 wherever it is built.
    -->
    <LangVersion>13.0</LangVersion>
    <RootNamespace>ZkData.Core</RootNamespace>
    <!-- linked legacy sources: their warnings belong to the original project -->
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0168;CS1998;CS0108;CS0114;CS0169;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="9.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <!-- COMPILE-TIME ONLY, and not a change of imaging library: ImageSharp above stays the
         one this project actually uses. ZkData.UnitSyncLib.Map declares three Image/Bitmap
         members, which the website never reads - it reads MinimapName and the other DB
         columns - but the type does not compile without them, and MapsController
         deserialises a real Map out of the registrar's metadata.
         The package is Windows-only AT RUNTIME: the assembly loads anywhere and only
         constructing a Bitmap throws, which nothing here does. The members are [XmlIgnore],
         so XmlSerializer does not touch them either. Maps/Detail deserialising a real Map on
         Linux is what establishes that, rather than this comment. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <!-- the entity classes, linked from ZkData and unmodified -->
  <ItemGroup>
    <Compile Include="..\ZkData\Ef\*.cs" Link="Linked\Ef\%(Filename).cs" />
    <Compile Include="..\ZkData\Enums\*.cs" Link="Linked\Enums\%(Filename).cs" />
  </ItemGroup>

