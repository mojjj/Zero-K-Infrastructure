@{
    // The site's own _ViewStart chooses between _AjaxLayout and _SiteLayout using
    // ViewContext.IsChildAction and Request.IsAjaxRequest(). IsChildAction is a PROPERTY on
    // MVC 5's ViewContext, and C# has no extension properties, so no shim can supply it -
    // that file needs an edit, which has not been made.
    //
    // This picks the same layout that file picks for an ordinary, non-ajax request, which is
    // every request this host serves.
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}
