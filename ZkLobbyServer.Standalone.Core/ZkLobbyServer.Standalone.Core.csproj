<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The standalone lobby server, as a .NET 9 process.

    ZkLobbyServer.Core proved the chain compiles. This starts it - the difference between an
    assembly that builds and one that runs, which this port has been careful to keep separate
    since the first schema diff.

    It LINKS the two files of ZkLobbyServer.Standalone rather than copying them, so the mono
    process that runs today and this one are the same program. That is the whole point: when the
    switch happens it is a change of runtime, not a change of code.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>13.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ZkLobbyServer.Standalone.Core</AssemblyName>
    <RootNamespace>ZkLobbyServer.Standalone</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0618;CS0168;CS0219;CS1998;CS4014;NU1701;NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ZkLobbyServer.Standalone\Program.cs" Link="Linked\Program.cs" />
    <Compile Include="..\ZkLobbyServer.Standalone\StandalonePlanetwarsEventCreator.cs" Link="Linked\StandalonePlanetwarsEventCreator.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZkLobbyServer.Core\ZkLobbyServer.Core.csproj" />
  </ItemGroup>

</Project>
