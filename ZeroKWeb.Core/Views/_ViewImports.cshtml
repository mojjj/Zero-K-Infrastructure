@* MVC 5 imported these through Views/Web.config <pages><namespaces>; ASP.NET Core uses
   this file instead. System.Web.Mvc, System.Web.Mvc.Ajax, System.Web.Mvc.Html and
   System.Web.Routing have no ASP.NET Core equivalent to import - the helpers they carried
   are on IHtmlHelper or are gone. *@
@using System
@using System.Collections.Generic
@using System.IO
@using System.Linq
@* not the real System.Web.Mvc - the linked helper file declares that namespace *@
@using System.Web.Mvc
@* AjaxOptions and InsertionMode, reimplemented in Mvc5Compat/AjaxCompat.cs against markup
   captured from MVC 5. The namespace is MVC 5's because 18 views name these types unqualified. *@
@using System.Web.Mvc.Ajax
@using PlasmaShared
@using ZkData
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using ZeroKWeb
@using ZeroKWeb.Compat
@inherits ZeroKWeb.Compat.ZkRazorPage<TModel>
