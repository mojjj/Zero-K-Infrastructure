@using ZeroKWeb
@using ZkData
@model ZeroKWeb.Controllers.PlanetwarsAdminController.PlanetwarsAdminModel

@{
    // Templated Razor delegates, in place of @helper blocks. @helper does not exist in ASP.NET
    // Core; this form parses in BOTH Razor v3 and the .NET 9 generator, which
    // tools/razor-v3-check/check.sh establishes rather than assumes. A templated delegate's
    // parameter is always called `item`.
    Func<Galaxy, object> AdminColumn =
        @<text>@if (item.IsDefault)
        {
            <span style="color: red; font-weight: bold">SELECTED</span>
        }
        else
        {
            @Html.PostLink("Select", "SetDefault", null, new { galaxyID = item.GalaxyID })
            <span>&nbsp;|&nbsp;</span>
            @Html.PostLink("Delete", "Delete", null, new { galaxyID = item.GalaxyID }, "js_confirm")
        }</text>;
}

@{
    Page.Title = "Planetwars Admin";
    var grid = new UniGrid<Galaxy>(Model.Galaxies, "Galaxy maps");
    grid.AddCol("ID", x => x.GalaxyID).SetSort(x => x.GalaxyID);
    grid.AddCol("Image", @<text>
                             <a href="@( Url.Action("Index", "Planetwars", new { galaxyId = item.GalaxyID }))">
                                 <img src="@( GlobalConst.BaseSiteUrl)/img/galaxies/render_@( item.GalaxyID).jpg" style="height: 80px"/>
                             </a></text>).SetSort(x => x.GalaxyID);
    grid.AddCol("Started", x => x.Started).SetSort(x => x.Started);
    grid.AddCol("Ended", x => x.Ended).SetSort(x => x.Ended);
    grid.AddCol("Turn", x => x.Turn).SetSort(x => x.Turn);
    grid.AddCol("Admin", AdminColumn);
}
<div id="grid">
    <h1>@Page.Title</h1>

    @*
        One form per button, not one form with three submit buttons whose NAME chose the action.
        That shape made the page's own action a write, and it also swallowed the Html.PostLink
        buttons below: PostLink renders a <form>, a form cannot nest inside another, so the browser
        dropped them and their buttons submitted here instead of to SetDefault or the map utils.
    *@
    <table>
        <tr>
            <td>Master switch</td>
            <td>
                <h3>@MiscVar.PlanetWarsMode</h3>
                @using (Ajax.BeginForm("SetMode", Global.GetAjaxOptions("grid", false)))
                {
                    @Html.AntiForgeryToken()
                    @Html.EnumDropDownListFor(x => x.PlanetWarsMode)<input type="submit" value="Switch"/>
                }
            </td>
        </tr>
        <tr>
            <td>Timed switch</td>
            <td>
                @using (Ajax.BeginForm("SetFutureMode", Global.GetAjaxOptions("grid", false)))
                {
                    @Html.AntiForgeryToken()
                    @Html.EnumDropDownListFor(x => x.PlanetWarsNextMode)<text>&nbsp;&nbsp;</text>
                    @Html.TextBoxFor(x => x.PlanetWarsNextModeDate, new { @class = "js_datetimepicker" })
                    <input type="submit" value="Set in future" />
                }
            </td>

        </tr>
        <tr>
            <td>Purge PlanetWars</td>
            <td>
                @using (Ajax.BeginForm("Purge", Global.GetAjaxOptions("grid", false)))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(x => x.LastSelectedGalaxyID)
                    <label>
                        @Html.CheckBoxFor(x => x.UnassignFactions)
                        Unassign factions
                    </label>
                    <label>
                        @Html.CheckBoxFor(x => x.ResetRoles)
                        Reset roles
                    </label>
                    <label>
                        @Html.CheckBoxFor(x => x.DeleteClans)
                        Delete clans
                    </label>

                    <input type="submit" value="Purge"/>
                }
            </td>
        </tr>

        <tr>
            <td>
                Selected map utils
            </td>
            <td>
                @Html.PostLink("Randomize maps", "RandomizeMaps", null, new { galaxyID = Model.LastSelectedGalaxyID }, "js_confirm")<br />
                @Html.PostLink("Set team sizes", "SetPlanetTeamSizes", null, new { galaxyID = Model.LastSelectedGalaxyID }, "js_confirm")<br />
                @Html.PostLink("Start galaxy", "StartGalaxy", null, new { galaxyID = Model.LastSelectedGalaxyID }, "js_confirm")<br />
                @Html.PostLink("Add wormholes", "AddWormholes", null, new { galaxyID = Model.LastSelectedGalaxyID }, "js_confirm")<br />
                @Html.PostLink("Own planets", "OwnPlanets", null, new { galaxyID = Model.LastSelectedGalaxyID }, "js_confirm")<br />
                @Html.PostLink("Reset all PW player ratings", "ResetRatings", null, null, "js_confirm")<br />
            </td>
        </tr>

    </table>

    @Html.Partial("~/Views/Shared/Grid/RenderTable.cshtml", grid)
</div>