@using ZeroKWeb
@using ZkData
@model ZkData.AccountRole
@{
    AccountRole entry = Model;
}
@if (MiscVar.PlanetWarsMode != PlanetWarsModes.AllOffline)
{
    if (Global.Account != null && Global.Account.CanVoteRecall(entry.Account, entry.RoleType))
    {
        <form class="postlink" method="post" action="@Url.Action("NominateRole", "Poll", new { roleTypeID = entry.RoleTypeID, removalAccountID = entry.AccountID, isRemoval = true })"
              onsubmit="return ZkPrompt(this, 'text', 'What is the reason?', 'He failed us!');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="text" />
            <button type="submit" class="postlink-button">(vote out)</button>
        </form>
    }
    <span>&nbsp;</span>
    if (Global.Account != null && Global.Account.CanRecall(entry.Account, entry.RoleType))
    {
        @Html.PostLink("(recall)", "RecallRole", "Planetwars", new { accountID = entry.AccountID, roleTypeID = entry.RoleTypeID }, "js_confirm")
    }
}