@using ZeroKWeb
@using ZkData
@model ZkData.Galaxy

@{
    var galaxy = Model;
    var mapWidth = 700;
    var mapHeight = 500;
}

@* Galaxy minimap, drawn as native SVG. This was a Raphael script block emitting one
   paper.rect()/paper.circle() call per link and planet. *@
<div id="notepad">
    <svg xmlns="http://www.w3.org/2000/svg" width="@mapWidth" height="@mapHeight"
         viewBox="0 0 @mapWidth @mapHeight" role="img" aria-label="Galaxy minimap">
        <defs>
            @foreach (var link in galaxy.Links)
            {
                <linearGradient id="mm@(link.PlanetID1)_@(link.PlanetID2)" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="@link.PlanetByPlanetID1.GetColor(Global.Account)" />
                    <stop offset="1" stop-color="@link.PlanetByPlanetID2.GetColor(Global.Account)" />
                </linearGradient>
            }
        </defs>
        @foreach (var link in galaxy.Links)
        {
            var x1 = link.PlanetByPlanetID1.X * mapWidth;
            var y1 = link.PlanetByPlanetID1.Y * mapHeight;
            var r = GalaxyMapGeometry.Link(x1, y1, link.PlanetByPlanetID2.X * mapWidth, link.PlanetByPlanetID2.Y * mapHeight, 2);

            <rect x="@GalaxyMapGeometry.N(r.X)" y="@GalaxyMapGeometry.N(r.Y)"
                  width="@GalaxyMapGeometry.N(r.Width)" height="@GalaxyMapGeometry.N(r.Length)"
                  fill="url(#mm@(link.PlanetID1)_@(link.PlanetID2))"
                  transform="rotate(@GalaxyMapGeometry.N(r.AngleDegrees) @GalaxyMapGeometry.N(x1) @GalaxyMapGeometry.N(y1))" />
        }
        @foreach (var planet in galaxy.Planets)
        {
            <circle cx="@GalaxyMapGeometry.N(planet.X * mapWidth)" cy="@GalaxyMapGeometry.N(planet.Y * mapHeight)" r="10"
                    fill="@planet.GetColor(Global.Account)" stroke="black" stroke-width="3" />
        }
    </svg>
</div> 
