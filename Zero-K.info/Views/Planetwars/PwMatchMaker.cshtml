@using LobbyClient
@using PlasmaShared
@using ZeroKWeb
@using ZkData
@model LobbyClient.PwMatchCommand
@{
    PwMatchCommand pw = Model;
    string text;
    var db = new ZkDataContext();
    if (pw.Mode == PwMatchCommand.ModeType.Attack)
    {
        text = "Pick a planet to attack";
    }
    else
    {
        var planetNames = string.Join(", ", pw.Options.Select(o => o.PlanetName + " (" + (o.AttackerFaction ?? "?") + ")"));
        text = string.Format("Defend options: {0}", planetNames);
    }
}

@*
    The outer Ajax.BeginForm that used to wrap all of this is gone. It posted to MatchMaker,
    contained no input of any kind, and nothing submitted it - "mmForm" appeared nowhere else in
    the repository, in markup or in script. It had to go rather than stay, because a form cannot
    nest inside another: each Join is its own form now, and inside that one the browser would have
    dropped them.
*@
<div id="matchMaker">
        <span id="pwTimer">
            Deadline: @Utils.PrintTimeRemaining(pw.DeadlineSeconds)
        </span>
        <span>@text</span>
        @foreach (PwMatchCommand.VoteOption opt in pw.Options)
        {
            <span style="border: 1px solid cyan;">
                @if (opt.CanSelectForBattle)
                {
                    @*
                        Was an Ajax.ActionLink: a GET, so a crafted link signed the player up to a
                        PlanetWars battle they had not chosen. Ajax.BeginForm renders method="post"
                        and jquery.unobtrusive-ajax serialises the form, token included, so this
                        stays an in-place replace rather than becoming a page load.
                    *@
                    using (Ajax.BeginForm("MatchMakerJoin", "Planetwars",
                        new { planetID = opt.PlanetID, attackerFaction = opt.AttackerFaction },
                        new AjaxOptions { UpdateTargetId = "matchMaker", InsertionMode = InsertionMode.Replace },
                        new { @class = "postlink" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="postlink-button">Join</button>
                    }
                }
                @Html.PrintPlanet(db.Planets.First(x => x.PlanetID == opt.PlanetID))
                <span>[@opt.AttackerFaction]</span>
                <span>[@opt.Count/@opt.Needed]</span>
                @if (opt.WinChance != null)
                {
                    <span>(WHR A:@opt.AttackerAvgWhr D:@opt.DefenderAvgWhr, @opt.WinChance% attacker)</span>
                }
                else if (opt.AttackerAvgWhr > 0)
                {
                    <span>(WHR @opt.AttackerAvgWhr)</span>
                }
            </span>
            <text>&nbsp; &nbsp;&nbsp;</text>
        }
</div>
