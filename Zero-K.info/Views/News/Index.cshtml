<?xml version="1.0" encoding="utf-8"?>
@using ZkData 
@model IEnumerable<News> 
@{Layout=null;}
@{
    // FirstOrDefault, because a site can have no news. First() threw here, so /News/Index - the
    // RSS feed, anonymous and on the bare GET surface - answered 500 to everyone on any
    // deployment whose News table was empty, which every new one is. lastBuildDate is optional
    // in RSS 2.0, so a feed with no items simply does not carry one.
    var latest = Model.FirstOrDefault();
}
<rss version="2.0">
    <channel>
        <title>Zero-K news</title>
        <link>@Url.Action("Index","Home",null,"http")</link>
        <description>News for the free open source RTS strategy game Zero-K</description>
        @if (latest != null)
        {
            @:<lastBuildDate>@latest.Created.ToUniversalTime().ToString("r")</lastBuildDate>
        }
        <language>en-us</language>
        @{
            foreach (News n in Model) {
                @:<item>
                    @:<title>@n.Title</title>
                    @:<link>@Url.Action("Thread","Forum", new {id = n.ForumThreadID},"http")</link>
                    @:<guid>@Url.Action("Thread","Forum", new {id = n.ForumThreadID},"http")</guid>
                    @:<pubDate>@n.Created.ToUniversalTime().ToString("r")</pubDate>
                    @:<description>@Html.Encode(Html.BBCodeCached(n))</description>
        	        if (n.ImageExtension != null)
        	        {
        	        	@:<enclosure url="@n.ImageRelativeUrl" length="@n.ImageLength" type="@n.ImageContentType"/>
        	        }
                @:</item>
            }
        }
    </channel>
</rss>