@using ZeroKWeb
@using ZeroKWeb.Controllers
@model EnginesController.EnginesModel

@{
    // Templated Razor delegates, in place of @helper blocks. @helper does not exist in ASP.NET
    // Core; this form parses in BOTH Razor v3 and the .NET 9 generator, which
    // tools/razor-v3-check/check.sh establishes rather than assumes. A templated delegate's
    // parameter is always called `item`.
    Func<EnginesController.EngineItem, object> DefEngine =
        @<text>@if (item.IsDefault)
        {
            <b style="color: red">*DEFAULT*</b>  @Html.ActionLink("rebuild steam", "MakeDefault", new { engine = item.Name });
        }
        else
        {
            @Html.ActionLink("make default", "MakeDefault", new { engine = item.Name });
        }</text>;
}
@{
    Page.Title = "Engine list";
    var grid = new UniGrid<EnginesController.EngineItem>(Model.Data);
    grid.AddCol("Name", x => x.Name).SetSort(x => x.Name);
    grid.AddCol("Platforms", x => string.Join(", ", x.Platforms));
    grid.AddCol("Default", DefEngine).SetSort(x => x.IsDefault);
}

<div id="grid">
    <h1>@Page.Title</h1>

    <div>
        @Model.Message
    </div>

    <form action="@Url.Action("Index", "Engines")">
        @Html.AntiForgeryToken()
        <div>
            <h3>Upload a new engine</h3>
            <table>
                <tr><td colspan="2"><b>Note: Use minimal-portable builds</b></td></tr>
                <tr><td>Name</td><td>@Html.TextBoxFor(x => x.UploadName)</td></tr>
                @for (int i = 0; i < EnginesController.EnginePlatforms.Length; i++)
                {
                    <tr>
                        <td>7z link for @EnginesController.EnginePlatforms[i]</td>
                        <td>
                            @Html.TextBox("UploadPlatforms[" + i + "]")
                        </td>
                    </tr>
                }
                <tr><td colspan="2"><button type="submit" name="upload" value="1" class="js_button">Upload</button></td></tr>
            </table>
        </div>
    </form>
    <hr/>

    @using (Ajax.BeginForm("Index", Global.GetAjaxOptions("grid")))
    {
        <table>
            <tr><td>Name</td><td>@Html.TextBoxFor(x => x.SearchName)</td></tr>
        </table>
        <input type="submit" value="Search" />


        @Html.Partial("~/Views/Shared/Grid/RenderTable.cshtml", grid)
    }
</div>